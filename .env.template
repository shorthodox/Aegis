# ============================================================
# Aegis-1 Terminal - Complete Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual values
# CRITICAL: Never commit your real .env file to version control!

# -------------------------------------------------------------------
# APP CORE
# -------------------------------------------------------------------
ENV=development
PORT=8000
FRONTEND_URL="http://localhost:8000"
BASE_URL="http://localhost:8000"

# -------------------------------------------------------------------
# FIREBASE CONFIGURATION (CRITICAL - Check your Firebase Project)
# -------------------------------------------------------------------
# Project: aegis-d78e1 (asia-south2 region - Delhi)

# Firebase Web SDK Configuration
FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY_HERE"
FIREBASE_AUTH_DOMAIN="aegis-d78e1.firebaseapp.com"
FIREBASE_DATABASE_URL="https://aegis-d78e1-default-rtdb.asia-southeast1.firebasedatabase.app"
FIREBASE_PROJECT_ID="aegis-d78e1"
FIREBASE_STORAGE_BUCKET="aegis-d78e1.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_SENDER_ID_HERE"
FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID_HERE"
FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID_HERE"

# Firebase Admin SDK (Backend)
FIREBASE_CREDENTIALS="config/serviceAccountKey.json"

# -------------------------------------------------------------------
# AUTHENTICATION & SECURITY (CRITICAL)
# -------------------------------------------------------------------
# JWT Secret for token generation
JWT_SECRET_KEY="YOUR_SECURE_JWT_SECRET_KEY_HERE_MIN_32_CHARS"
ALGORITHM="HS256"

# Google OAuth Configuration (for signInWithPopup)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID_HERE"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET_HERE"

# Microsoft OAuth (Optional)
MICROSOFT_CLIENT_ID="YOUR_MICROSOFT_CLIENT_ID_HERE"
MICROSOFT_CLIENT_SECRET="YOUR_MICROSOFT_CLIENT_SECRET_HERE"

# Apple OAuth (Optional)
APPLE_CLIENT_ID="YOUR_APPLE_CLIENT_ID_HERE"
APPLE_CLIENT_SECRET="YOUR_APPLE_CLIENT_SECRET_HERE"

# -------------------------------------------------------------------
# EMAIL CONFIGURATION
# -------------------------------------------------------------------
MAIL_USERNAME="your_email@gmail.com"
MAIL_PASSWORD="your_app_specific_password"
MAIL_FROM="noreply@aegis.com"

# -------------------------------------------------------------------
# PAYMENT GATEWAY - CASHFREE
# -------------------------------------------------------------------
# Cashfree Payment Gateway Credentials
CASHFREE_APP_ID="YOUR_CASHFREE_APP_ID_HERE"
CASHFREE_SECRET_KEY="YOUR_CASHFREE_SECRET_KEY_HERE"
CASHFREE_ENV="TEST"  # Use "TEST" for sandbox, "PRODUCTION" for live

# -------------------------------------------------------------------
# WEBSOCKET CONFIGURATION
# -------------------------------------------------------------------
WS_BASE_URL="ws://localhost:8000"
API_BASE_URL="http://localhost:8000"

# -------------------------------------------------------------------
# BOT CONFIGURATION
# -------------------------------------------------------------------
ALPHA_MODE_DEFAULT="OFF"

# Trading Capital and Risk Settings
INITIAL_CAPITAL="10000"
RISK_PER_TRADE="2"
ALPHA_MODE_RISK="3"
MAX_POSITION="2000"

# -------------------------------------------------------------------
# BINANCE EXCHANGE CONFIGURATION (Optional)
# -------------------------------------------------------------------
# Only needed if running live trading engine
BINANCE_API_KEY="YOUR_BINANCE_API_KEY_HERE"
BINANCE_API_SECRET="YOUR_BINANCE_API_SECRET_HERE"

# -------------------------------------------------------------------
# PROXY CONFIGURATION (Optional)
# -------------------------------------------------------------------
# If behind a corporate proxy or need to route through VPN
PROXY_URL=""

# -------------------------------------------------------------------
# DATABASE
# -------------------------------------------------------------------
DATABASE_URL="sqlite:///./users.db"

# -------------------------------------------------------------------
# LOGGING
# -------------------------------------------------------------------
LOG_LEVEL="INFO"
