# -------------------------------------------------------------------
# PAYMENT GATEWAY - WHOP (Primary) > PADDLE > DODO PAYMENTS > RAZORPAY
# -------------------------------------------------------------------
# Provider is chosen by which credentials are present, in that order. Setting
# WHOP_API_KEY switches the site to Whop; unsetting it rolls straight back to
# Paddle/DODO/Razorpay with no code change.
#
# Whop. Get these from the Whop dashboard:
#   WHOP_API_KEY        Developer > API keys
#   WHOP_WEBHOOK_SECRET Developer > Webhooks > your endpoint. Base64; a
#                       'whsec_' prefix is stripped automatically.
#   WHOP_PLAN_ID_*      Dashboard > Checkout links > (link) > ... > Details
#                       (plan_...). These are PLAN ids. There is no documented
#                       API to create checkout links, so they are made by hand
#                       in the dashboard first.
# Point the webhook at  POST /api/v1/payments/webhook  and subscribe to
# payment.succeeded and membership.activated. Both may arrive for one purchase;
# the handler is idempotent.
WHOP_API_KEY=""
WHOP_WEBHOOK_SECRET=""
WHOP_MODE="sandbox"          # sandbox | live
WHOP_PLAN_ID_BASIC=""
WHOP_PLAN_ID_INTERMEDIATE=""
WHOP_PLAN_ID_PRO=""
# Optional. Where Whop returns the buyer after checkout. Access is granted by
# the WEBHOOK, not this redirect, so a buyer who closes the tab still gets what
# they paid for.
WHOP_REDIRECT_URL=""
# Escape hatches — only needed if Whop moves the API. Defaults are
# https://api.whop.com/api/v1 and /checkout_configurations.
# WHOP_API_BASE=""
# WHOP_CHECKOUT_CONFIG_PATH=""
# WHOP_WEBHOOK_TOLERANCE_SECONDS="300"
#
# Paddle Billing (NOT Paddle Classic). Get these from the Paddle dashboard:
#   PADDLE_API_KEY      Developer tools > Authentication  (pdl_sdbx_apikey_... / pdl_live_apikey_...)
#   PADDLE_WEBHOOK_SECRET  Developer tools > Notifications > your destination  (pdl_ntfset_...)
#   PADDLE_PRICE_ID_*   Catalog > Products > (product) > Prices  (pri_...)
# NOTE: these are PRICE ids, not product ids — Paddle bills against a price.
# Also set a default payment link under Checkout settings, or the API returns
# a transaction with no checkout URL.
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_MODE="sandbox"                  # sandbox or live  (defaults to sandbox)
PADDLE_PRICE_ID_BASIC=""
PADDLE_PRICE_ID_INTERMEDIATE=""
PADDLE_PRICE_ID_PRO=""
# Webhook replay window, seconds. Paddle's SDKs default to 5, which only works
# with a tightly synced clock; 300 matches the common industry default and
# Paddle retries rejected deliveries anyway.
PADDLE_WEBHOOK_TOLERANCE_SECONDS="300"

DODO_PAYMENTS_API_KEY="test_your_dodo_api_key_here"
DODO_PAYMENTS_WEBHOOK_SECRET="your_dodo_webhook_secret_here"
DODO_PAYMENTS_MODE="test"  # test or live
DODO_PRODUCT_ID_BASIC=""
DODO_PRODUCT_ID_INTERMEDIATE=""
DODO_PRODUCT_ID_PRO=""

