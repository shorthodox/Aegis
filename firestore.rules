rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------
    // Helpers
    // ----------------------------------------------------------------

    function isAuthed() {
      return request.auth != null;
    }

    // True if the doc ID matches the caller's uid OR their email.
    // Needed because the backend keys user docs by email while the
    // client SDK (ensureUserDocumentV2) keys them by uid.
    function ownsDoc(userId) {
      return request.auth.uid == userId
          || request.auth.token.email == userId;
    }

    // Fetch user data — try uid-keyed doc first (client-created),
    // fall back to email-keyed doc (backend-created via Admin SDK).
    // Returns null when neither exists.
    function getUserData() {
      let uidPath   = /databases/$(database)/documents/users/$(request.auth.uid);
      let emailPath = /databases/$(database)/documents/users/$(request.auth.token.email);
      return exists(uidPath)
        ? get(uidPath).data
        : (request.auth.token.email != null && exists(emailPath)
            ? get(emailPath).data
            : null);
    }

    // True when the user has any active plan (trial or paid).
    // Trial expiry is enforced server-side; rules check plan existence only
    // because trial_end is stored as an ISO string and cannot be compared
    // with the Timestamp type of request.time in Firestore rules.
    function isSubscriptionActive() {
      let d = getUserData();
      let plan = d != null ? d.get('plan', d.get('tier', '')) : '';
      return plan == 'trial'
          || plan == 'pro'
          || plan == 'premium'
          || plan == 'intermediate'
          || plan == 'basic';
    }

    // Fields only the Admin SDK may ever write. Trial windows are
    // SERVER-AUTHORITATIVE: trial_end is what is_trial_expired() reads
    // (main.py:3129), and trial_used gates one-trial-per-account
    // (main.py:4282). A client that can write its own expiry has no expiry.
    function adminOnlyFields() {
      return ['tier', 'trial_end', 'trialEnd', 'trial_start', 'trial_used',
              'subscription_active'];
    }

    // UPDATE: neither plan, nor the subscription map, nor any admin-only
    // field may change. Unchanged from the original guard except for the
    // two fields added above.
    function planFieldsUnchanged() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(adminOnlyFields())
          && !changed.hasAny(['plan', 'subscription']);
    }

    // CREATE: the same fields must be absent entirely. This guard did not
    // exist before — planFieldsUnchanged() was only applied to update, and
    // it reads resource.data, which does not exist on a create. A client
    // could therefore set an arbitrary trial_end at document creation and
    // hold a trial that never expires. Reachable via a setDoc(merge) on the
    // email-keyed doc when only the uid-keyed doc existed, because that is
    // a create, not an update.
    //
    // `subscription` is NOT in adminOnlyFields because legitimate signup
    // (auth.js:82) writes {status:'none', startDate:null, ...} as part of the
    // initial document. Forbidding it outright would reject every new account.
    // It is permitted here only in that benign shape: a forged
    // status == 'active' is rejected. It remains fully locked on update.
    function createFieldsSafe() {
      return !request.resource.data.keys().hasAny(adminOnlyFields())
          && (!('subscription' in request.resource.data)
              || request.resource.data.subscription.get('status', '') != 'active');
    }

    // ----------------------------------------------------------------
    // Users collection
    // ----------------------------------------------------------------
    match /users/{userId} {

      // Owner reads their own doc (uid-keyed or email-keyed)
      allow read: if isAuthed() && ownsDoc(userId);

      // Initial doc creation: only allow plan == 'trial' (or no plan field),
      // and no admin-only field may be present at all.
      allow create: if isAuthed()
        && ownsDoc(userId)
        && (!('plan' in request.resource.data)
            || request.resource.data.plan == 'trial')
        && createFieldsSafe();

      // Updates allowed only when plan/subscription fields are untouched.
      allow update: if isAuthed()
        && ownsDoc(userId)
        && planFieldsUnchanged();

      // Deletes via client are not permitted — backend Admin SDK handles cleanup.
      allow delete: if false;

      // User preferences — full owner read/write
      match /preferences/{doc=**} {
        allow read, write: if isAuthed() && ownsDoc(userId);
      }

      // Per-user trade subcollection — owner reads, backend writes
      match /trades/{doc=**} {
        allow read:  if isAuthed() && ownsDoc(userId);
        allow write: if false;
      }
    }

    // ----------------------------------------------------------------
    // Signals — subscription/trial required; backend writes only
    // ----------------------------------------------------------------
    match /signals/{signalId} {
      allow read:  if isAuthed() && isSubscriptionActive();
      allow write: if false;
    }

    // ----------------------------------------------------------------
    // Analytics — any authenticated user may read; backend writes only
    // ----------------------------------------------------------------
    match /analytics/{docId} {
      allow read:  if isAuthed();
      allow write: if false;
    }

    // ----------------------------------------------------------------
    // Reviews — public read (shown on landing page); backend writes only
    // ----------------------------------------------------------------
    match /reviews/{reviewId} {
      allow read:  if true;
      allow write: if false;
    }

    // Removed 2026-08-13: rules for /trades, /subscriptions, and /transactions.
    // All three collections were verified EMPTY via the Firestore REST API
    // (0 documents, database 'default'), and no backend or frontend code reads
    // or writes them. An unused permissive rule is pure attack surface — the
    // /transactions rule in particular allowed owner-create on a collection
    // nothing validates. The catch-all deny below now covers these paths.

    // ----------------------------------------------------------------
    // Deny everything else
    // ----------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
