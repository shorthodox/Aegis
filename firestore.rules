rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection — each user reads/writes only their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == userId);

      // User preferences subcollection
      match /preferences/{document=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == userId);
      }

      // User trades subcollection
      match /trades/{document=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == userId);
      }
    }

    function isSubscriptionActive() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      
      let plan = userData.get('plan', userData.get('tier', ''));
      let isPaid = plan == 'premium' || plan == 'pro' || plan == 'intermediate' || plan == 'basic';
      
      let hasActiveFlag = userData.get('subscription_active', false) == true || request.auth.token.subscription_active == true;
      
      let trialEnd = userData.get('trial_end', userData.get('trialEnd', null));
      let isTrialNotExpired = trialEnd != null && trialEnd > request.time;
      
      let trialStart = userData.get('trial_start', userData.get('trialStart', userData.get('createdAt', null)));
      let isDerivedTrialNotExpired = trialStart != null && trialStart > (request.time - duration.value(3, 'd'));
      
      return isPaid || hasActiveFlag || isTrialNotExpired || isDerivedTrialNotExpired;
    }

    // Signals collection — readable by users with active subscriptions or trials, written by admin SDK only
    match /signals/{signalId} {
      allow read: if request.auth != null && isSubscriptionActive();
      allow write: if false;
    }

    // Analytics collection — readable by all authenticated users, written by admin SDK only
    match /analytics/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Root-level trades collection — owner read only, written by admin SDK only
    match /trades/{tradeId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Subscriptions collection — document ID must equal caller's UID
    match /subscriptions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Transactions / audit logs — owner read, server write
    match /transactions/{transactionId} {
      allow read: if request.auth != null &&
                     resource.data.userId == request.auth.uid;
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
